# Offline development ONLY. Deployed environments set GCP_PROJECT_ID and read these from Secret Manager.
# Copy to .env.local (git-ignored). Leave ANTHROPIC_API_KEY empty to use the deterministic offline engine.
ADMINZERO_ENV=development
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://localhost:5432/adminzero
SIEM_WEBHOOK_SECRET=change-me-locally
VAULT_KMS_KEY=local-dev-kms-key
ADMINZERO_ALLOWED_ORIGINS=http://localhost:3000,https://ramon983.github.io
